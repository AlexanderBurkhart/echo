{
  "type": "object",
  "properties": {
    "ratings": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/rating"}
    },
    "quantities": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/rating"}
    }
  },
  "required": ["ratings", "quantities"],
  "additionalProperties": false,
  "$defs": {
    "rating": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {"type": "number", "minimum": 0},
            "unit": {"type": "string", "minLength": 1},
            "evidence": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1
            }
          },
          "required": ["value", "unit", "evidence"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "value": {"type": "null"},
            "unit": {"type": ["string", "null"]},
            "evidence": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          },
          "required": ["value", "unit", "evidence"],
          "additionalProperties": false
        }
      ]
    }
  }
}
